{
  "name": "ui-loop",
  "version": "0.1.0",
  "description": "Context-budgeted visual feedback for coding agents: see the UI you just changed as diff-only crops plus a structured text summary, within a token budget.",
  "author": {
    "name": "Jignesh",
    "url": "https://djig.github.io"
  },
  "homepage": "https://github.com/djig/ui-loop",
  "repository": "https://github.com/djig/ui-loop",
  "license": "MIT",
  "keywords": [
    "ui",
    "screenshot",
    "visual-diff",
    "playwright",
    "a11y",
    "mcp",
    "context-budget",
    "frontend"
  ],
  "mcpServers": {
    "ui-loop": {
      "command": "npx",
      "args": [
        "-y",
        "@djignesh21/ui-loop@0.1.2",
        "serve"
      ]
    }
  },
  "displayName": "UI Loop",
  "documentationUrl": "https://github.com/djig/ui-loop#readme",
  "supportUrl": "https://github.com/djig/ui-loop/issues"
}
